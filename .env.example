# PUSHD settings, without values. Two services read them: the engine (engine/.env or its environment) and the site
# (web/.env.local or its environment). Where a name is listed under both, set the same value on both.
# Keys go in the host's secret settings only, never in a file in git.

# ---------- engine: the watcher and the feed API (engine/README.md) ----------
PUSHD_GITHUB_TOKEN=
PUSHD_OPENROUTER_KEY=
PUSHD_OPENROUTER_MODEL=
PUSHD_LIVE_KEY=
PUSHD_ENGINE_PORT=
PUSHD_ENGINE_HOST=
PUSHD_PUBLIC_DELAY_MINUTES=
PUSHD_BACKFILL_HOURS=
PUSHD_DB=
PUSHD_WATCHLIST=
PUSHD_MEDIA=
PUSHD_MEDIA_DIR=
PUSHD_MEDIA_PER_HOUR=
# holders' added accounts' lines (never the public feed); the admin key for suggestions and /v1/admin/status (also on the site)
PUSHD_EXTRAS_DB=
PUSHD_ADMIN_KEY=

# ---------- engine: the Top list (engine/README.md, "The Top list") ----------
PUSHD_RANK=
PUSHD_TOP_SIZE=
PUSHD_RANK_ENTER=
PUSHD_RANK_ENTER_PASSES=
PUSHD_RANK_EXIT=
PUSHD_RANK_EXIT_PASSES=
PUSHD_RANK_MIN_DWELL_HOURS=
PUSHD_RANK_CAMP_MIN=
PUSHD_RANK_DECAY_DAYS=
PUSHD_RANK_EVERY_MIN=
PUSHD_RANK_DEEP_EVERY_HOURS=
PUSHD_RANK_SEARCH_PER_MIN=
PUSHD_RANK_DEEP_OWNERS=
PUSHD_RANK_GHARCHIVE=
PUSHD_RANK_GHARCHIVE_BACKFILL_HOURS=
PUSHD_POOL_MIN_LIQUIDITY_USD=
PUSHD_POOL_MIN_VOLUME_USD=
PUSHD_POOL_MIN_PAIR_DAYS=
PUSHD_POOL_ACTIVE_DAYS=
PUSHD_POOL_MAX_MCAP_USD=
PUSHD_POOL_CHAINS=
PUSHD_POOL_GECKO_CATEGORIES=
PUSHD_POOL_DEX_SEARCH=
PUSHD_POOL_CODE_SEARCH_PAGES=
PUSHD_POOL_WEBSITES_PER_DAY=
PUSHD_POOL_PUMPFUN=
PUSHD_DEX_PER_MIN=
PUSHD_GECKO_PER_MIN=
PUSHD_GECKO_DETAILS_PER_DAY=
# more accounts never in the pool, and the private never-shown list (accounts, and "repo:name" for repo names)
PUSHD_DENY=
PUSHD_DENY_PRIVATE=

# ---------- engine: the GitHub allowance's shares, requests an hour (src/plan.ts) ----------
PUSHD_GH_SHARE_WATCH=
PUSHD_GH_SHARE_LOOKUP=
PUSHD_GH_SHARE_EXTRA=
PUSHD_GH_SHARE_ENRICH=
PUSHD_GH_SHARE_RANK=

# ---------- engine: look up anyone, holders watch any account (src/lookup.ts, src/holderwatch.ts) ----------
PUSHD_LOOKUP_TTL_MIN=
PUSHD_LOOKUP_SEARCH_TTL_MIN=
PUSHD_LOOKUP_PER_MIN=
PUSHD_LOOKUP_PER_HOUR=
PUSHD_LOOKUP_SEARCH_PER_MIN=
PUSHD_LOOKUP_HOLDER_READS=
PUSHD_LOOKUP_PUBLIC_READS=
PUSHD_LOOKUP_VISITOR_READS=
PUSHD_HOLDER_WATCH_TIERS=
PUSHD_HOLDER_WATCH_ADDS_PER_HOUR=
PUSHD_EXTRA_ACCOUNTS_MAX=

# ---------- engine: $PUSHD (docs/token.md) ----------
# the two contracts, from contracts/broadcast/token.env after contracts/token-deploy.sh (also set on the site)
PUSHD_BURN_POT_ADDRESS=
PUSHD_SPLITTER_ADDRESS=
# the block the burn pot was deployed in (token.env has it): where burns are looked for
PUSHD_BURN_POT_BLOCK=
# $PUSHD itself, after the launch (read from the burn pot when empty; also set on the site)
PUSHD_TOKEN_ADDRESS=
# Robinhood Chain RPC for reads; the public node when empty. On a host use a paid node (also set on the site)
PUSHD_TOKEN_RPC_URL=
PUSHD_EXPLORER_URL=
# holders: whole $PUSHD for the live feed (1000000), how long a balance is trusted (10 min), how long a sign-in lasts (7 days)
PUSHD_HOLDER_MIN=
PUSHD_HOLDER_CACHE_MINUTES=
PUSHD_HOLDER_SESSION_DAYS=
# the site the sign-in message names (https://pushd.fun when empty)
PUSHD_SITE_URL=
# the keeper: off with PUSHD_KEEPER=off. Its key is a fresh wallet holding a little ETH for gas, nothing else (secret)
PUSHD_KEEPER=
PUSHD_KEEPER_KEY=
PUSHD_KEEPER_RPC_URL=
PUSHD_KEEPER_EVERY_MINUTES=
PUSHD_KEEPER_MIN_GAS_ETH=
PUSHD_KEEPER_MAX_GWEI=
PUSHD_KEEPER_DAILY_GAS=
PUSHD_KEEPER_MIN_SWEEP_ETH=

# ---------- engine: the agent layer (engine/README.md, "The agent layer") ----------
# the scouts use PUSHD_OPENROUTER_KEY above; without it every call is a template call. Locally ~/.pushd-openrouter-key works too
PUSHD_SCOUTS=
PUSHD_SCOUT_MODEL=
PUSHD_SCOUT_DEEP_MODEL=
PUSHD_SCOUT_MODEL_PRICE=
PUSHD_SCOUT_DEEP_MODEL_PRICE=
PUSHD_SCOUT_DAILY_USD=
PUSHD_SCOUT_CALL_MAX_USD=
PUSHD_SCOUT_GAP_MS=
PUSHD_SCOUT_README_BYTES=
PUSHD_SCOUT_FILES=
PUSHD_SCOUT_FILE_BYTES=
PUSHD_SCOUT_TREE=
PUSHD_SCOUT_CATCHUP=
PUSHD_SCOUT_HOURLY_USD=
PUSHD_SCOUT_MODEL_CALLS_PER_DAY=
PUSHD_SCOUT_MIN_HEAT=
PUSHD_SCOUT_DEEP_MIN_HEAT=
PUSHD_SCOUT_DEDUPE_HOURS=
PUSHD_MY_SCOUT_TIERS=
PUSHD_MY_SCOUT_DRAFTS_PER_HOUR=
PUSHD_MY_SCOUT_SAVES_PER_HOUR=
# pay per call goes to the burn pot (PUSHD_BURN_POT_ADDRESS); closed until it is set
PUSHD_AGENT_PAID=
PUSHD_AGENT_PRICE_LIVE_ETH=
PUSHD_AGENT_PRICE_DEEP_READ_ETH=
PUSHD_AGENT_PAY_MAX_AGE_MIN=
PUSHD_AGENT_FREE_PER_MIN=
PUSHD_AGENT_KEY_PER_MIN=
PUSHD_AGENT_PAID_PER_HOUR=
# 1 when the engine is reached only through the site's proxy on a private network
PUSHD_AGENT_TRUST_PROXY=

# ---------- engine: PUSHD Agents, anyone's own agent on GitHub (docs/agents.md) ----------
# off unless PUSHD_AGENTS=on (set it on the site too). The six app settings come from engine/scripts/github-app.ts;
# the private key, the webhook secret and the client secret are secret
PUSHD_AGENTS=
PUSHD_GH_APP_ID=
PUSHD_GH_APP_SLUG=
PUSHD_GH_APP_PRIVATE_KEY=
PUSHD_GH_APP_WEBHOOK_SECRET=
PUSHD_GH_APP_CLIENT_ID=
PUSHD_GH_APP_CLIENT_SECRET=
# free runs a day without a holding (5); the holders' fair-use guard (30 an hour, 300 a day); all agents' model spend a
# UTC day (5 USD) and one call's worst case (0.08); one paid run in ETH, paid to the burn pot (0.00003)
PUSHD_AGENTS_FREE_PER_DAY=
PUSHD_AGENTS_HOLDER_PER_HOUR=
PUSHD_AGENTS_HOLDER_PER_DAY=
PUSHD_AGENTS_DAILY_USD=
PUSHD_AGENTS_CALL_MAX_USD=
PUSHD_AGENTS_RUN_PRICE_ETH=
PUSHD_AGENTS_TIERS=
PUSHD_AGENTS_MODEL=
PUSHD_AGENTS_DRAFTS_PER_HOUR=
PUSHD_AGENTS_WEBHOOKS_PER_MIN=
PUSHD_AGENTS_SESSION_DAYS=
# the scouts' own repos (PushdFun/pushd-scout-<id>, engine/scripts/scout-repos.ts), their daily builds, automerge (off)
PUSHD_SCOUTS_ORG=
PUSHD_SCOUT_BUILDS=
PUSHD_SCOUT_AUTOMERGE=

# ---------- engine: alerts with PUSHD closed (web push for holders, engine/src/push.ts) ----------
# off while empty. Make a pair once with `npx web-push generate-vapid-keys` in engine/ (the private key is secret);
# the subject is a contact for the push services: https://pushd.fun when empty, never a personal address
PUSHD_VAPID_PUBLIC_KEY=
PUSHD_VAPID_PRIVATE_KEY=
PUSHD_VAPID_SUBJECT=

# ---------- site (web) ----------
NEXT_PUBLIC_SITE_URL=
# where the site reads the feed, the token panel and holder sign-in; the sample shows when empty
PUSHD_ENGINE_URL=
# $PUSHD on the site: the token for the Buy button (else asked from the engine), and where Buy leads (else its Pons page)
PUSHD_TOKEN_ADDRESS=
PUSHD_BUY_URL=
# the launch page (/token/launch): on only for the launch, then off again
PUSHD_LAUNCH_PAGE=
PUSHD_LAUNCH_OPENING_BUY_WEI=
PUSHD_LAUNCH_FILE=
PUSHD_BURN_POT_ADDRESS=
PUSHD_SPLITTER_ADDRESS=
PUSHD_TOKEN_RPC_URL=
PUSHD_EXPLORER_URL=
# the admin page (/admin/suggestions): the same key as the engine's PUSHD_ADMIN_KEY
PUSHD_ADMIN_KEY=
# PUSHD Agents: on shows /build, /shipped and the Build nav entry (the same as the engine's; docs/agents.md)
PUSHD_AGENTS=
