{
  "name": "pushd-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PUSHD's watcher: reads public GitHub activity for the watchlist, filters, scores, summarizes and serves the feed.",
  "scripts": {
    "start": "tsx src/cli/run.ts",
    "watch": "tsx src/cli/watch.ts",
    "serve": "tsx src/cli/serve.ts",
    "replay": "tsx src/cli/replay.ts",
    "verify-watchlist": "tsx src/cli/verify-watchlist.ts",
    "keeper": "tsx src/cli/keeper.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit",
    "rank": "tsx src/cli/rank.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "tsx": "^4.23.15",
    "viem": "2.57.7",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
